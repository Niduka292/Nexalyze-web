# ─── Nexora Solutions — Environment Variables ─────────────────────────────────
#
# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local to git.

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Site URL ───────────────────────────────────────────────────────────────────
# Used for OG tags and canonical URLs
NEXT_PUBLIC_SITE_URL=https://nexorasolutions.lk

# ── Analytics (optional) ───────────────────────────────────────────────────────
# Uncomment if using Vercel Analytics or Plausible
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nexorasolutions.lk
